{
  "expo": {
    "name": "MotoSpot",
    "slug": "moto-spot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_opaque.png",
    "scheme": "moto-spot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon_opaque.png",
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your camera ",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.juwon33.motospot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon_transparent.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": true,
      "package": "com.juwon33.motospot"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/icon_transparent.png",
          "imageWidth": 5120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed256454-4a5a-4c6c-bfc2-ad21c052e9c4"
      }
    },
    "owner": "juwon34"
  }
}
